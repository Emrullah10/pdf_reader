{
  "name": "pdf-reader-mono-repo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/modules/*",
    "core/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest --selectProjects integration",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "db:build-schema": "node scripts/build-schema.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2"
  }
}
